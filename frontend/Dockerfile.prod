# =============================================================================
# Production frontend image: build static SPA + serve with nginx.
# Note: VITE_* env vars are baked at build time (Vite replaces them in the
# bundle), so they must be passed as build args, not runtime env.
# =============================================================================

# ---------- Stage 1: build ----------
FROM node:20-alpine AS builder
WORKDIR /app

# Default API + WS to relative paths so the reverse-proxy in front routes them.
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_WS_URL=/api/v1/ws
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_WS_URL=$VITE_WS_URL

COPY package.json ./
RUN npm install --no-audit --no-fund

COPY . .
RUN npm run build

# ---------- Stage 2: runtime ----------
FROM nginx:1.27-alpine AS runtime

RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

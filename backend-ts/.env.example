# =============================================================================
# TypeScript backend environment.
# Copy to .env (or use the root .env that docker-compose injects).
# =============================================================================

# --- App ---
APP_ENV=dev
APP_NAME=Stock Intelligence System
API_PREFIX=/api/v1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- PostgreSQL ---
# Prisma uses one URL. Same DB as the Python backend so a future cutover is painless.
DATABASE_URL=postgresql://stockai:stockai@postgres:5432/stockai?schema=public

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- ChromaDB ---
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- LLM provider ---
# One of: gemini | openai | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# --- Embeddings ---
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# --- Auth ---
JWT_SECRET=change-me-please-this-must-be-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- External APIs ---
FINNHUB_API_KEY=
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# EditorConfig — consistent formatting across editors
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
trim_trailing_whitespace = false  # two-space trailing = line break in Markdown

[Makefile]
indent_style = tab

# =============================================================================
# Production .env — copy to .env.prod and fill in real values.
# =============================================================================

# --- App ---
APP_ENV=prod
APP_NAME=Stock Intelligence System
API_PREFIX=/api/v1
# Restrict to your real frontend origin(s). DO NOT use "*" in production.
CORS_ORIGINS=["https://stocks.your-domain.com"]

# --- PostgreSQL ---
POSTGRES_USER=stockai
# CHANGE THIS — `openssl rand -base64 24` is a fine source
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
POSTGRES_DB=stockai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- ChromaDB ---
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- LLM provider ---
# Ollama-on-host is generally NOT reachable from a containerized prod
# environment unless you also run Ollama in the same VPC / VPS. For most
# production deploys, switch to openai or gemini here.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional alternatives:
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Auth ---
# REQUIRED: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
# The app fails to start in prod if this is shorter than 32 chars or still has "change-me".
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS_FROM_SECRETS_TOKEN_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- External data APIs ---
FINNHUB_API_KEY=
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- SMTP (alerts) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@your-domain.com
SMTP_USE_TLS=true

# --- Ops ---
# When true, the backend runs `alembic upgrade head` on startup.
# Safe for single-replica deploys; race-prone with multiple replicas — in that
# case run migrations manually before rolling the new image.
RUN_MIGRATIONS_ON_START=true
